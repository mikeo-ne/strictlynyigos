# Public URL of the site (used in emails & payment redirects).
# On Vercel you can leave this empty until you add a custom domain — it falls back to your
# project's production *.vercel.app address. Set it once you have e.g. https://strictlynyigos.ug
SITE_URL=http://localhost:3000

# ---- Database (Postgres) ----
# On Vercel: Storage → Create → Neon (Postgres) → connect to the project. That sets DATABASE_URL for you.
# Locally: leave empty to use a built-in embedded Postgres stored in ./data/pg (zero setup),
# or paste your Neon connection string to work against the real database.
DATABASE_URL=

# ---- Image uploads ----
# On Vercel: Storage → Create → Blob → connect to the project. That sets BLOB_READ_WRITE_TOKEN.
# Locally: leave empty and uploads are saved to ./data/uploads.
BLOB_READ_WRITE_TOKEN=

# Local data folder (embedded database + local uploads). Not used on Vercel.
DATA_DIR=./data

# Optional: create the first admin automatically when running `npm run seed`
# (otherwise visit /admin/setup on first launch)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---- Payments ----
# "demo" simulates a Mobile Money checkout (no real money moves).
# "flutterwave" uses Flutterwave hosted checkout (MTN MoMo, Airtel Money, cards).
PAYMENTS_PROVIDER=demo
FLW_SECRET_KEY=
# The "secret hash" you set in the Flutterwave dashboard for webhooks
FLW_WEBHOOK_HASH=

# ---- Email (SMTP) ----
# If SMTP_HOST is empty, emails are not sent; they are saved to the Outbox in /admin.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
MAIL_FROM="Strictly Nyigos <tickets@strictlynyigos.ug>"

# Extra hostnames allowed to submit forms when behind a proxy (comma separated)
ALLOWED_ORIGINS=
